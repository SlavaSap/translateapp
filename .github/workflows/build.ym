  name: Build APK                                                                                                                                                                                                                   
                                                                                                                                                                                                                                    
  on:                                                                                                                                                                                                                               
    push:                                                                                                                                                                                                                           
      branches: [ main ]                                                                                                                                                                                                            
    workflow_dispatch:                                                                                                                                                                                                              
                                                                                                                                                                                                                                    
  jobs:                                                                                                                                                                                                                             
    build:                                                                                                                                                                                                                          
      runs-on: ubuntu-latest                                                                                                                                                                                                        
      steps:                                                                                                                                                                                                                        
      - uses: actions/checkout@v3                                                                                                                                                                                                   
      - uses: actions/setup-python@v4                                                                                                                                                                                               
        with:                                                                                                                                                                                                                       
          python-version: '3.10'                                                                                                                                                                                                    
      - uses: actions/setup-java@v3                                                                                                                                                                                                 
        with:                                                                                                                                                                                                                       
          java-version: '11'                                                                                                                                                                                                        
          distribution: 'temurin'                                                                                                                                                                                                   
      - name: Install deps                                                                                                                                                                                                          
        run: pip install buildozer cython && pip install -r requirements.txt                                                                                                                                                        
      - name: Build                                                                                                                                                                                                                 
        run: buildozer android debug                                                                                                                                                                                                
      - uses: actions/upload-artifact@v3                                                                                                                                                                                            
        with:                                                                                                                                                                                                                       
          name: apk                                                                                                                                                                                                                 
          path: bin/*.apk 
