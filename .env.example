# Translate App Configuration

# Google API Keys (если нужны для расширенного использования)
# GOOGLE_API_KEY=your_api_key_here

# Языки для OCR (по умолчанию: русский, английский, украинский и др.)
OCR_LANGUAGES=ru,en,uk,de,fr,es,ja,zh

# Целевой язык для перевода
TARGET_LANGUAGE=ru

# Минимальная уверенность OCR (0.0-1.0)
OCR_CONFIDENCE=0.5

# Энергетический порог микрофона
MIC_ENERGY_THRESHOLD=4000

# Время ожидания для голосовой команды (в секундах)
LISTEN_TIMEOUT=10

# Максимальное время фразы для микрофона (в секундах)
PHRASE_TIME_LIMIT=5

# Язык для распознавания речи
SPEECH_LANGUAGE=ru-RU

# Debug режим
DEBUG=False
